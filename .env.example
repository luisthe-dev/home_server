# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# Network binding: 127.0.0.1 for local only, 0.0.0.0 for LAN access
BIND_IP=127.0.0.1

# MySQL
MYSQL_ROOT_PASSWORD=change_me_mysql_password
MYSQL_PORT=3306

# PostgreSQL
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_INSIGHT_PORT=5540

# Raphael (Ollama Engine & Personas)
OLLAMA_PORT=11434
# Optional: Comma-separated models. If left blank, raphael/models.txt is used.
OLLAMA_MODELS=llama3.1,gemma4,deepseek-r1,qwen3.5,qwen2.5-coder

# SearxNG
SEARXNG_PORT=1234
SEARXNG_BASE_URL=http://127.0.0.1:1234/
# Generate secret key using: openssl rand -hex 32
SEARXNG_SECRET_KEY=change_me_to_32_byte_hex_string

# Meilisearch
MEILI_PORT=7700
# Generate master key using: openssl rand -base64 32
MEILI_MASTER_KEY=change_me_to_secure_meili_master_key
MEILI_ENV=production
